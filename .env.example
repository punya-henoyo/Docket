# Copy to .env and fill in. Never commit the real file.

# Any LiteLLM provider/model string.
DOCKET_LLM=anthropic/claude-sonnet-5

# Fallback key. A provider-specific var (ANTHROPIC_API_KEY, OPENAI_API_KEY, ...)
# is auto-detected by LiteLLM and works just as well.
# Point at a self-hosted or proxied deployment (company gateway, vLLM, Ollama,
# an OpenAI-compatible reseller). Leave unset for a provider's public API.
# For an OpenAI-compatible gateway use the openai/ prefix plus the gateway's own
# deployment name, e.g. DOCKET_LLM=openai/gpt-4.1
#DOCKET_LLM_BASE_URL=https://your-gateway.example.com/openai/v1/

LLM_API_KEY=

# Budgets
DOCKET_MAX_COST_USD=2.00
DOCKET_MAX_CHILD_COST_USD=0.75
DOCKET_MAX_AGENTS=6

# Optional: real web search for agents.
# tavily | brave | serper | perplexity | deepseek
# DOCKET_SEARCH_PROVIDER=tavily
# DOCKET_SEARCH_API_KEY=

# Optional: local logging (critical|error|warning|info|debug). Default: warning.
# DOCKET_LOG_LEVEL=info
