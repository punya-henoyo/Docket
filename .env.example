# Copy to .env and fill in. .env is gitignored; never commit real keys.

# ── Model ────────────────────────────────────────────────────────────────────
# Any LiteLLM provider/model string. Examples:
#   anthropic/claude-sonnet-5
#   openai/gpt-5.4
#   deepseek/deepseek-chat            (DeepSeek's own API)
DOCKET_LLM=anthropic/claude-sonnet-5
LLM_API_KEY=

# Only for an OpenAI-COMPATIBLE endpoint that is not the provider's own host:
# Azure AI Foundry, a self-hosted vLLM/Ollama, an internal gateway. Leave unset for
# anthropic/, openai/, deepseek/ and friends — they already know their own host.
#
# With Azure AI Foundry, the part after `openai/` is the AZURE DEPLOYMENT name, which
# is not always the model's catalogue name. List what is actually deployed with:
#   curl -H "api-key: $KEY" "$ENDPOINT/models"
# Example (DeepSeek V4 Pro on Azure AI Foundry):
#   DOCKET_LLM=openai/DeepSeek-V4-Pro
#   DOCKET_LLM_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1/
# DOCKET_LLM_BASE_URL=

# ── Budgets ──────────────────────────────────────────────────────────────────
# Checked BEFORE each model turn, so a run stops rather than discovering the overage
# afterwards. Scan-wide, per-specialist, and a concurrent agent cap.
# LiteLLM prices most known models itself. It CANNOT price a custom Azure deployment
# name or a self-hosted model, and an unpriced model makes the ceiling below a silent
# no-op. Set both (USD per MILLION tokens, as providers quote) to restore enforcement.
# DOCKET_PRICE_INPUT_PER_1M=
# DOCKET_PRICE_OUTPUT_PER_1M=

DOCKET_MAX_COST_USD=2.00
DOCKET_MAX_CHILD_COST_USD=0.75
DOCKET_MAX_AGENTS=6

# ── Optional: live web search ────────────────────────────────────────────────
# Unset means agents work only from what they can observe on the target; the tool
# refuses explicitly rather than inventing results.
# DOCKET_SEARCH_PROVIDER=tavily        # tavily | brave | serper | perplexity | deepseek
# DOCKET_SEARCH_API_KEY=

# ── Optional: GitHub connect console (`docket connect`) ──────────────────────
# Register a GitHub App with Contents:read + Metadata:read and callback
# http://127.0.0.1:8765/auth/callback. A classic OAuth App cannot do read-only.
# DOCKET_GITHUB_CLIENT_ID=
# DOCKET_GITHUB_CLIENT_SECRET=

# ── Optional: accurate token counting ────────────────────────────────────────
# Without this, pre-flight sizing uses chars/4, which (measured against DeepSeek V4
# Pro) undercounts JSON tool results by ~38% and raw HTTP by ~40% — so docket thinks
# it is at 60% of the context window when it is really at 100%, and compaction only
# fires after the provider rejects the request. The bundled DeepSeek tokenizer is
# within ~2%. Needs `pip install tokenizers`; falls back silently if absent.
# DOCKET_TOKENIZER_PATH=engine/docket/llm/tokenizers/deepseek-v3.json
